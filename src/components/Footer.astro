---
import EditLink from 'virtual:starlight/components/EditLink';
import Pagination from 'virtual:starlight/components/Pagination';
import docs from '../../docs.json';
import { REPO_URL } from '../lib/site.ts';

const { entry } = Astro.locals.starlightRoute;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const issueUrl = `${REPO_URL}/issues/new?title=${encodeURIComponent('Docs: ' + entry.data.title)}&body=${encodeURIComponent(pageUrl)}`;
---

<footer class="ed-footer">
	<div class="ed-page-meta">
		<EditLink />
		<a class="ed-issue" href={issueUrl}>Report an issue</a>
	</div>
	<Pagination />
	<div class="ed-footer-links">
		{
			(docs.footer?.links ?? []).map((col) => (
				<section>
					<h2>{col.title}</h2>
					<ul>
						{col.items.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</footer>
