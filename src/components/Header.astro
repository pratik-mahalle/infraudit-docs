---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import docs from '../../docs.json';
import { tabs, chapterFor, headerLinks } from '../lib/nav.ts';

const all = tabs(docs);
const active = chapterFor(docs, Astro.locals.starlightRoute.id)?.tab.label ?? all[0].label;
const { beside, right, cta } = headerLinks(docs);
---

<div class="ed-header">
	<a class="ed-wordmark" href={all[0].href}>{docs.name} Docs</a>
	<nav class="ed-tabs" aria-label="Sections">
		{all.map((t) => <a class="ed-tab" href={t.href} aria-current={t.label === active ? 'page' : undefined}>{t.short}</a>)}
		{beside.map((l) => <a class="ed-beside" href={l.href}>{l.label}</a>)}
	</nav>
	<div class="ed-search"><Search /></div>
	<div class="ed-header-links">
		{right.map((l) => <a href={l.href}>{l.label}</a>)}
	</div>
	{cta && <a class="ed-cta" href={cta.href}>{cta.label}</a>}
	<ThemeSelect />
</div>
