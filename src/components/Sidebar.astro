---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import docs from '../../docs.json';
import { tabs, chapterFor, headerLinks } from '../lib/nav.ts';

const route = Astro.locals.starlightRoute;
const all = tabs(docs);
const active = chapterFor(docs, route.id)?.tab.label ?? all[0].label;
const { beside, right } = headerLinks(docs);

// starlightSidebar() makes one top-level group per tab; show only the active tab's groups.
const tab = route.sidebar.find((e) => e.type === 'group' && e.label === active);
const groups = (tab?.type === 'group' ? tab.entries : []).flatMap((g) => (g.type === 'group' ? [g] : []));
let n = 0;
const num = () => String(++n).padStart(2, '0');
---

<div class="ed-mobile-nav">
	{all.map((t) => <a class="ed-tab" href={t.href} aria-current={t.label === active ? 'page' : undefined}>{t.short}</a>)}
	{[...beside, ...right].map((l) => <a href={l.href}>{l.label}</a>)}
</div>

<div class="ed-sidebar">
	{
		groups.map((g) => (
			<section>
				<h2 class="ed-group">{g.label}</h2>
				<ul>
					{g.entries.map(
						(l) =>
							l.type === 'link' && (
								<li>
									<a href={l.href} aria-current={l.isCurrent ? 'page' : undefined}>
										<span class="ed-label">{l.label}</span>
										<span class="ed-num">{num()}</span>
									</a>
								</li>
							),
					)}
				</ul>
			</section>
		))
	}
</div>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
