---
import Default from '@astrojs/starlight/components/TableOfContents.astro';
import { extractMarginNotes } from '../lib/margin-notes.ts';

const notes = extractMarginNotes(Astro.locals.starlightRoute.entry.rendered?.html ?? '');
---

<Default />
{notes.length > 0 && <div class="margin-notes" set:html={notes.join('')} />}
