---
import Default from '@astrojs/starlight/components/Head.astro';
import themeJson from '../../theme.json';
import { resolveTheme, themeCss, fontLinks, type ThemeInput } from '../lib/theme.ts';

// A ThemeError here stops the build (or shows the dev overlay) with its message.
const theme = resolveTheme(themeJson as ThemeInput);
---

<Default />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{fontLinks(theme.fonts).map((href) => <link rel="stylesheet" href={href} />)}
<Fragment set:html={`<style>${themeCss(theme)}</style>`} />
