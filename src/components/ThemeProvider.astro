---
import themeJson from '../../theme.json';
import { resolveTheme, initialTheme, type ThemeInput } from '../lib/theme.ts';

const { mode } = resolveTheme(themeJson as ThemeInput);
// Ships the tested initialTheme() itself, so the page and the tests can't disagree.
const script = `(() => {
	let stored = null;
	try { stored = localStorage.getItem('starlight-theme'); } catch {}
	document.documentElement.dataset.theme = (${initialTheme})(${JSON.stringify(mode)}, stored);
})();`;
---

{/* Inline and render-blocking, like Starlight's own, to avoid a flash of the wrong theme. */}
<script is:inline set:html={script} />
